# Bu dosyayı `.env.local` olarak kopyalayın ve değerleri doldurun.
# `.env.local` git'e girmez (.gitignore) — parola ve anahtarlar orada kalır.

# Kanonik adres: sitemap, hreflang ve Open Graph için mutlak kök adres.
NEXT_PUBLIC_SITE_URL=https://www.arslanhukuk.com.tr


# ─────────────────────────────────────────────────────────────────────────
# İletişim formu teslimatı
#
# Aşağıdaki üç yoldan YALNIZCA BİRİNİ doldurmanız yeterlidir. Hiçbiri
# doldurulmazsa /api/iletisim 501 döner ve form, mesajın iletilmediğini
# kullanıcıya açıkça bildirir — mesaj sessizce kaybolmaz.
#
# Denenme sırası: SMTP → Webhook → Resend.
# ─────────────────────────────────────────────────────────────────────────

# 1) SMTP — TERCİH EDİLEN YOL
# Büronun kendi mail sunucusu üzerinden gönderir. Araya yeni bir hizmet
# sağlayıcı girmez, veri yurt dışına çıkmaz. Bilgileri alan adı/hosting
# sağlayıcınızın panelinden alabilirsiniz.
SMTP_HOST=mail.arslanhukuk.com.tr
SMTP_PORT=465
# 465 için örtük TLS, 587 için STARTTLS kullanılır. Porttan otomatik
# belirlenir; sunucunuz farklı davranıyorsa true/false ile geçersiz kılın.
# SMTP_SECURE=true
SMTP_USER=site@arslanhukuk.com.tr
SMTP_PASSWORD=
# Gönderen adres. Çoğu sunucu, kimliği doğrulanmış kutudan başka bir
# göndericiyi reddeder; boş bırakılırsa SMTP_USER kullanılır.
# CONTACT_FROM_EMAIL=site@arslanhukuk.com.tr

# 2) Webhook — mesajı bir otomasyona/tabloya iletir (Zapier, Make, n8n...).
# CONTACT_WEBHOOK_URL=

# 3) Resend — SMTP erişimi yoksa e-posta API'si.
# Gönderen adres, Resend'de DOĞRULANMIŞ bir alan adında olmalıdır.
# Resend ABD merkezlidir; yurt dışına veri aktarımı doğar (KVKK m.9).
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=site@arslanhukuk.com.tr

# Mesajların düşeceği kutu. Tanımlanmazsa src/lib/content/site.ts
# içindeki büro e-postası kullanılır. Her üç yol için de geçerlidir.
# CONTACT_TO_EMAIL=alperarslan@istanbulbarosu.org.tr
